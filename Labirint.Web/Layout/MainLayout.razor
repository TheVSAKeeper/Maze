@inherits LayoutComponentBase

<nav class="rail" aria-label="Основная навигация">
    <img class="rail__mark"
         src="./icon-512.png"
         alt="Лабиринт"
         title="Лабиринт – MaxNagibator эдишен"
         width="34"
         height="34" />

    <NavMenu />

    <div class="ui-spacer"></div>

    <IconButton Icon="@IconCatalog.Theme"
                OnClick="@ToggleThemeAsync"
                Title="Сменить тему" />
    <IconButton Icon="@IconCatalog.Settings"
                OnClick="@OpenParametersAsync"
                Title="Параметры" />
</nav>

<main>
    <ErrorBoundary>
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent Context="exception">
            <Alert Severity="UiSeverity.Error">Произошла ошибка.</Alert>
            <pre>@exception</pre>
        </ErrorContent>
    </ErrorBoundary>
</main>

<DialogHost />
<ToastHost />
