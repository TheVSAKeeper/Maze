@using Labirint.Web.Parameters

<Dialog>
    <ChildContent>
        <div class="ui-stack ui-stack--4">
            <ControlSchemeSwitcher @ref="_controlScheme" />

            <div class="ui-row ui-row--4">
                <Switch @bind-Value="_parameters.IsSoundOn"
                        Label="Звук" />
                @if (_parameters.IsSoundOn)
                {
                    <Slider @bind-Value="_parameters.SoundVolume"
                            Max="1f"
                            Min="0f"
                            Step="0.01f"
                            T="float"
                            ValueLabelFormat="0%" />
                }
            </div>

            <div class="ui-stack ui-stack--2">
                <div class="t-label">Цвет лабиринта</div>
                <ColorField @bind-Value="_parameters.Color" />
            </div>
        </div>
    </ChildContent>
    <Actions>
        <Button OnClick="Cancel">Отмена</Button>
        <Button Disabled="_isProcessing"
                OnClick="Reset"
                Tone="UiTone.Warning">
            Сбросить
        </Button>
        <Button Disabled="_isProcessing"
                OnClick="UpdateAsync"
                Tone="UiTone.Success">
            @if (_isProcessing)
            {
                <Spinner Size="18" />
            }
            else
            {
                <span>Сохранить</span>
            }
        </Button>
    </Actions>
</Dialog>
