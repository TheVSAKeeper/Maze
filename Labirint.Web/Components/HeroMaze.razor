<div class="hero-maze">
    <button aria-label="Показать другой лабиринт"
            class="hero-maze__surface"
            @onclick="Regenerate"
            title="Другой лабиринт"
            type="button">
        <svg aria-hidden="true"
             class="hero-maze__grid"
             preserveAspectRatio="xMidYMid meet"
             viewBox="-1 -1 @(Side + 2) @(Side + 2)"
             xmlns="http://www.w3.org/2000/svg">
            <rect class="hero-maze__floor"
                  height="@Side"
                  width="@Side"
                  x="0"
                  y="0" />

            <g @key="_run.Seed"
               style="@RunStyle">
                <rect class="hero-maze__exit @(_run.IsSolved ? "hero-maze__exit--found" : null)"
                      height="@(Cell - 10)"
                      width="@(Cell - 10)"
                      x="@(ExitX * Cell + 5)"
                      y="@(ExitY * Cell + 5)" />

                <g class="hero-maze__walls">
                    @for (var index = 0; index < _run.Walls.Count; index++)
                    {
                        var wall = _run.Walls[index];

                        <line style="animation-delay: @(index * WallDrawStep)ms"
                              x1="@wall.X1"
                              y1="@wall.Y1"
                              x2="@wall.X2"
                              y2="@wall.Y2" />
                    }
                </g>

                <path class="hero-maze__trail"
                      d="@_run.TrailPath" />

                <path class="hero-maze__tail"
                      d="@_run.TrailPath" />

                <circle class="hero-maze__runner"
                        cx="0"
                        cy="0"
                        r="4" />
            </g>
        </svg>
    </button>

    <p class="t-label hero-maze__caption">Зерно @_run.Seed</p>
</div>
