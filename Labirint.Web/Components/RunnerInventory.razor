@inherits RenderComponent

<MudStack Row
          Spacing="3">
    @foreach (var animatedStack in _stackCache.Values)
    {
        var stack = animatedStack.Stack;
        var item = stack.Item;

        if (stack.Count <= 0 && animatedStack.IsIdle)
        {
            continue;
        }

        <div class="inventory-item-container">
            <div class="inventory-item
                            @(stack.IsInfinite ? " score" : string.Empty)
                            @(animatedStack.GetAnimation())"
                 @onanimationend="() => AnimationCompleted(animatedStack)">

                <img alt="@item.DisplayName"
                     @onclick="() => OnClicked(item)"
                     src="@item.Icon"
                     title="Использовать предмет">
                <div class="item-name"
                     @onmouseout="HideDescription"
                     @onmouseover="() => ShowDescription(item)">
                    @item.DisplayName
                </div>
                <div class="count"
                     title="Текущие количество в инвентаре">@stack.Count</div>
                <div class="max-count"
                     title="Максимальной количество в инвентаре">@(stack.IsInfinite ? "∞" : stack.MaxCount)</div>
            </div>

            @{
                var control = item.ControlSettings;

                if (control != null)
                {
                    <div class="keyboard-button"
                         @onclick="() => OnClicked(item)"
                         title="Использовать предмет">
                        <span>
                            @ControlScheme.GetActivateKey(control).DisplaySymbol
                        </span>
                    </div>
                }
            }
        </div>
    }
</MudStack>

@if (_showDescription && _currentItem != null)
{
    <MudPopover AnchorOrigin="Origin.BottomCenter"
                Open="@_showDescription"
                Paper
                Style="max-width: 600px"
                TransformOrigin="Origin.TopCenter">
        <MudCard Outlined>
            <MudCardContent>
                @foreach (var paragraph in _currentItem.Description.Split("\n"))
                {
                    if (paragraph.StartsWith("---", StringComparison.InvariantCultureIgnoreCase))
                    {
                        <MudDivider Class="my-2"
                                    DividerType="DividerType.FullWidth"
                                    Light
                                    Style="height: 2px;" />
                    }
                    else
                    {
                        <MudText Align="Align.Justify">@paragraph</MudText>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudPopover>
}
