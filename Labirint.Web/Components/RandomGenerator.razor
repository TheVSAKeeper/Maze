<div class="ui-row">
    <TextField @bind-Value="_userSeed"
               HelperText="@(IsGenerateRequired ? "Необходима генерация" : $"Число зерна: {_currentSeed}")"
               Label="Зерно генерации"
               OnBlur="ResetSeed" />
    <IconButton Disabled="IsGenerateRequired"
                Icon="@IconCatalog.Share"
                OnClick="ShowShareDialogAsync"
                Title="Поделиться лабиринтом"
                Tone="UiTone.Accent" />
</div>
