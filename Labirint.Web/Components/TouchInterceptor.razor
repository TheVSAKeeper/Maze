<SwipeArea OnSwipe="OnSwipe">
    @ChildContent

    <div class="touch-zone touch-zone--top" @onclick="@(() => OnZoneClicked(Direction.Top))"></div>
    <div class="touch-zone touch-zone--left" @onclick="@(() => OnZoneClicked(Direction.Left))"></div>
    <div class="touch-zone touch-zone--right" @onclick="@(() => OnZoneClicked(Direction.Right))"></div>
    <div class="touch-zone touch-zone--bottom" @onclick="@(() => OnZoneClicked(Direction.Bottom))"></div>
</SwipeArea>
