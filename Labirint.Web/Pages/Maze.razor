@page "/labirint/{seed?}"

<PageTitle>Labirint</PageTitle>

@if (IsInit == false)
{
    <MudStack AlignItems="AlignItems.Center"
              Row>
        <MudProgressCircular Indeterminate />
        <MudText Typo="Typo.body1">Загрузка..</MudText>
    </MudStack>
}

<div class="workspace"
     hidden="@(!IsInit)">
    <div class="header-panel">
        @if (IsInit)
        {
            <div class="score-panel">
                <MudStack AlignItems="AlignItems.Center"
                          Row>
                    <MudIcon Color="Color.Warning"
                             Icon="@MaterialDesignIcons.Normal.Bitcoin"
                             Size="Size.Large" />
                    <MudText Color="Color.Warning"
                             Typo="Typo.h4">
                        @_labyrinth.Runner.Score.ToString("N0")
                    </MudText>
                </MudStack>
            </div>
        }

        <MudButton EndIcon="@(_isSettingsHidden ? MaterialDesignIcons.Normal.ArrowExpandDown : MaterialDesignIcons.Normal.ArrowExpandUp)"
                   OnClick="() => _isSettingsHidden = !_isSettingsHidden"
                   Size="Size.Large"
                   StartIcon="@MaterialDesignIcons.Normal.Cog"
                   Variant="Variant.Outlined">
            Параметры
        </MudButton>
    </div>

    @if (IsInit)
    {
        <div class="game">
            <div class="main-panel">
                <div class="ability-panel">
                    <RunnerAbilities Abilities="@_labyrinth.Runner.Abilities" />
                </div>

                <div class="field">
                    <Animation Delay="@Delay.None"
                               Effect="AnimationService.AnimationEffect"
                               IterationCount="1"
                               Speed="TimeSpan.FromMilliseconds(200.0)">
                        <CascadingValue Value="_renderParameter">
                            <TouchInterceptor @ref="_touchInterceptor">
                                <MazeFloor @ref="_mazeFloor" />
                                <MazeWalls @ref="_mazeWalls" />
                                <MazeEntities @ref="_mazeEntities" />
                            </TouchInterceptor>
                        </CascadingValue>

                        @{
                            var runner = _labyrinth.Runner;
                            var scale = 0.9;
                            var position = _vision.GetDraw(runner.Position);
                            var (entitySize, drawPosition) = AlignmentHelper.GetAlignmentParameters(_boxSize, _wallWidth, scale, position, Alignment.Center);

                            _runnerScaleX = runner.LastDirection switch
                            {
                                Direction.Right => 1,
                                Direction.Left => -1,
                                _ => _runnerScaleX,
                            };

                            <div style="position:absolute;
                                z-index: 100;
                                left: @(-30)px;
                            top: @(drawPosition.Y - 4)px;">
                                <MudText Typo="Typo.h6">@(runner.Position.Y + 1)</MudText>
                            </div>

                            <div style="position:absolute;
                                z-index: 100;
                                left: @(drawPosition.X + 4)px;
                            top: @(-30)px;">
                                <MudText Typo="Typo.h6">@(runner.Position.X + 1)</MudText>
                            </div>

                            <img alt="Бегун"
                                 src="images/runner.png"
                                 style="position:absolute;
                                     z-index: 100;
                                     left: @(drawPosition.X)px;
                                 top: @(drawPosition.Y)px;
                                 width: @(entitySize)px;
                                 height: @(entitySize)px;
                                 transform: scaleX(@_runnerScaleX) scaleY(1);" />
                        }
                    </Animation>
                </div>

                <div class="inventory-panel">
                    <RunnerInventory Interceptor="_keyInterceptor"
                                     Inventory="_labyrinth.Runner.Inventory" />
                </div>
            </div>
        </div>
    }

    <div class="control-panel"
         hidden="@_isSettingsHidden">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Параметры:</MudText>
            <RandomGenerator Density="@_density"
                             IsExitFound="@_isExitFound"
                             @ref="_seeder"
                             Seed="@Seed"
                             Size="@_originalSize" />
            <MudStack>
                <MudNumericField @bind-Value="_originalSize"
                                 DebounceInterval="300"
                                 Label="Размер"
                                 Max="@MaxSize"
                                 Min="@MinSize" />
                <MudSlider @bind-Value="_originalSize"
                           Color="Color.Info"
                           Max="@MaxSize"
                           Min="@MinSize"
                           Size="Size.Medium" />
            </MudStack>
            <MudStack>
                <MudNumericField @bind-Value="_density"
                                 DebounceInterval="300"
                                 Label="Плотность"
                                 Max="100"
                                 Min="0" />
                <MudSlider @bind-Value="_density"
                           Color="Color.Info"
                           Max="100"
                           Min="0"
                           Size="Size.Medium" />
            </MudStack>

            <MudButton Color="Color.Info"
                       FullWidth
                       OnClick="GenerateAsync"
                       Variant="Variant.Outlined">Генерировать
            </MudButton>
            <KeyInterceptor Inventory="_labyrinth?.Runner.Inventory"
                            @ref="_keyInterceptor" />
        </MudStack>
    </div>
</div>
