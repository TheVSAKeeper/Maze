@page "/labirint/{seed?}"
@inherits SafeComponent

<PageTitle>Labirint</PageTitle>

@if (IsInit == false)
{
    <div class="loading ui-row ui-row--2">
        <Spinner />
        <span class="t-body">Загрузка..</span>
    </div>
}

<div class="workspace"
     hidden="@(IsInit == false)">
    <div class="header-panel">
        @if (IsInit)
        {
            <div class="score">
                <span class="t-label">Счёт</span>
                <span class="score__value ui-row ui-row--2">
                    <Icon Name="@IconCatalog.Coin"
                          Size="26" />
                    <span class="t-data score__number">@_labyrinth.Runner.Score.ToString("N0")</span>
                </span>
            </div>
        }

        <div class="ui-spacer"></div>

        <IconButton Icon="@IconCatalog.Settings"
                    OnClick="OpenSettings"
                    @ref="_settingsButton"
                    Size="22"
                    Title="Параметры"
                    Variant="UiVariant.Outlined" />
    </div>

    @if (IsInit)
    {
        <div class="game">
            <div class="main-panel">
                <div class="ability-panel">
                    <RunnerAbilities Abilities="@_labyrinth.Runner.Abilities" />
                </div>

                <div class="field">
                    <Animation Delay="@Delay.None"
                               Effect="AnimationService.AnimationEffect"
                               IterationCount="1"
                               Speed="TimeSpan.FromMilliseconds(200.0)">
                        <CascadingValue Value="_renderParameter">
                            <TouchInterceptor @ref="_touchInterceptor">
                                <MazeFloor @ref="_mazeFloor" />
                                <MazeWalls @ref="_mazeWalls" />
                                <MazeEntities @ref="_mazeEntities" />
                            </TouchInterceptor>
                        </CascadingValue>

                        @{
                            var runner = _labyrinth.Runner;
                            var scale = 0.9;
                            var position = _vision.GetDraw(runner.Position);
                            var (entitySize, drawPosition) = AlignmentHelper.GetAlignmentParameters(_boxSize, _wallWidth, scale, position, Alignment.Center);

                            _runnerScaleX = runner.LastDirection switch
                            {
                                Direction.Right => 1,
                                Direction.Left => -1,
                                _ => _runnerScaleX,
                            };

                            <div class="coord t-data"
                                 style="position:absolute;
                                z-index: 100;
                                left: @(-30)px;
                            top: @(drawPosition.Y - 4)px;">@(runner.Position.Y + 1)</div>

                            <div class="coord t-data"
                                 style="position:absolute;
                                z-index: 100;
                                left: @(drawPosition.X + 4)px;
                            top: @(-30)px;">@(runner.Position.X + 1)</div>

                            <img alt="Бегун"
                                 src="images/runner.png"
                                 style="position:absolute;
                                     z-index: 100;
                                     left: @(drawPosition.X)px;
                                 top: @(drawPosition.Y)px;
                                 width: @(entitySize)px;
                                 height: @(entitySize)px;
                                 transform: scaleX(@_runnerScaleX) scaleY(1);" />
                        }
                    </Animation>
                </div>

                <div class="inventory-panel">
                    <RunnerInventory Interceptor="_keyInterceptor"
                                     Inventory="_labyrinth.Runner.Inventory" />
                </div>
            </div>
        </div>
    }
</div>

@if (_isSettingsOpen)
{
    <div class="sheet-scrim"
         @onclick="CloseSettings"></div>
}

<div aria-hidden="@(_isSettingsOpen == false)"
     aria-label="Параметры"
     class="sheet @(_isSettingsOpen ? "sheet--open" : null)"
     @onkeydown="OnSettingsKeyDown"
     @ref="_settingsSheet"
     role="dialog"
     tabindex="-1">
    <div class="sheet__head ui-row ui-row--between">
        <span class="t-display-m">Параметры:</span>
        <IconButton Icon="@IconCatalog.Close"
                    OnClick="CloseSettings"
                    Title="Закрыть параметры" />
    </div>

    <div class="sheet__body ui-stack ui-stack--5">
        <RandomGenerator Density="@_density"
                         IsExitFound="@_isExitFound"
                         @ref="_seeder"
                         Seed="@Seed"
                         Size="@_originalSize" />

        <div class="ui-stack ui-stack--1">
            <NumberField @bind-Value="_originalSize"
                         Label="Размер"
                         Max="MaxSize"
                         Min="MinSize" />
            <Slider @bind-Value="_originalSize"
                    Max="MaxSize"
                    Min="MinSize"
                    Step="1" />
        </div>

        <div class="ui-stack ui-stack--1">
            <NumberField @bind-Value="_density"
                         Label="Плотность"
                         Max="MaxDensity"
                         Min="MinDensity" />
            <Slider @bind-Value="_density"
                    Max="MaxDensity"
                    Min="MinDensity"
                    Step="1" />
        </div>

        <Button FullWidth
                OnClick="GenerateAsync"
                StartIcon="@IconCatalog.Refresh"
                Tone="UiTone.Accent">
            Генерировать
        </Button>

        <KeyInterceptor Inventory="_labyrinth?.Runner.Inventory"
                        @ref="_keyInterceptor" />
    </div>
</div>
