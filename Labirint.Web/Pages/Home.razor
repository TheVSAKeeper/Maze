@page "/"

<PageTitle>Дом</PageTitle>

<div class="home">
    <section class="hero ui-stack ui-stack--4">
        <h1 class="t-display-xl">Лабиринт</h1>
        <p class="t-body-s hero__standfirst">Стены ставит случай, выход один, нить кончается раньше, чем коридоры.</p>

        <div>
            <Button OnClick="StartGame"
                    StartIcon="@IconCatalog.Play"
                    Tone="UiTone.Accent"
                    Variant="UiVariant.Filled">
                Играть
            </Button>
        </div>
    </section>

    <div class="sections">
        <section class="section">
            <h2 class="t-label section__eyebrow">(Не)забавные факты:</h2>

            <div class="facts">
                @foreach (var fact in _facts)
                {
                    <p class="t-body fact">@fact</p>
                    <hr class="ui-hairline" />
                }
            </div>
        </section>

        <section class="section">
            <h2 class="t-label section__eyebrow">(Не)смешные шутки</h2>

            <div class="jokes ui-stack ui-stack--4">
                @foreach (var joke in _jokes)
                {
                    <p class="joke">@joke</p>
                }
            </div>
        </section>
    </div>
</div>
