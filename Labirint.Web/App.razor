<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView DefaultLayout="@typeof(MainLayout)"
                   RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData"
                         Selector="h1" />
    </Found>

    <Navigating>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="ui-row">
                <Spinner />
                <span class="t-body-s">Загрузка..</span>
            </div>
        </LayoutView>
    </Navigating>

    <NotFound>
        <PageTitle>Нот фоунд</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="ui-stack ui-stack--5">
                <Alert Severity="UiSeverity.Warning">Братан, видать адресочком ошибся</Alert>
                <h1 class="t-display-l">Ну, бывает такое</h1>
                <p class="t-body">Не расстраивайся, давай попробуем найти то, что ты искал?</p>
                <div class="ui-row">
                    <a class="ui-btn ui-btn--outlined ui-btn--accent"
                       href="./">Вернуться на главную</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
