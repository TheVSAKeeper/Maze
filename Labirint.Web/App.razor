<Router AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Labirint.Web.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView DefaultLayout="@typeof(MainLayout)"
                   RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData"
                         Selector="h1" />
    </Found>

    <Navigating>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="ui-row">
                <Spinner />
                <span class="t-body-s">Загрузка..</span>
            </div>
        </LayoutView>
    </Navigating>
</Router>
